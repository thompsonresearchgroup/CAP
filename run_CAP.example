#!/bin/bash
#SBATCH --partition=cpu384g
#SBATCH --job-name="H2 CAP"
#SBATCH --mem=300G
#SBATCH --time=60:00:00
#SBATCH --cpus-per-task=32
#SBATCH --output=/dev/null
#SBATCH --error=/dev/null
set -euo pipefail

# ==============================================================================
# Configuration
# ==============================================================================
CAPGEN="$HOME/CAP/noCAPs2withCAPs"
WORKDIR="$HOME/CAP"
OUTDIR="$HOME/CAP"
INPUT_FILE="input.txt"
# Note: CAP magnitude (-i*eta) is applied downstream by TDCIS/SNOWMAN;
# this generator produces eta-independent integrals.
N_LEBEDEV=3470
N_RADIAL=500
R_CUT=6.22
R_MIN=0.0
R_MAX=100.0
LEBEDEV_FILE="$WORKDIR/lebedev/lebedev_${N_LEBEDEV}.txt"
LOG_FILE="$OUTDIR/CAP_r${R_CUT}.log"

# ==============================================================================
# Main
# ==============================================================================
cd "$WORKDIR"

export OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK:-32}
export OMP_PROC_BIND=close
export OMP_PLACES=cores

mkdir -p "$OUTDIR"

echo "CAP Generation: r_cut=$R_CUT, threads=$OMP_NUM_THREADS" | tee "$LOG_FILE"
echo "Working directory: $(pwd)" | tee -a "$LOG_FILE"
echo "Started: $(date)" | tee -a "$LOG_FILE"

"$CAPGEN" \
    -f "$INPUT_FILE" \
    --lebedev_grid "$LEBEDEV_FILE" \
    --r_min "$R_MIN" \
    --r_max "$R_MAX" \
    --n_lebedev "$N_LEBEDEV" \
    --n_radial "$N_RADIAL" \
    --r_cut "$R_CUT" \
    2>&1 | tee -a "$LOG_FILE"

if [[ -f "CAP_Mat.mat" ]]; then
    mv CAP_Mat.mat "$OUTDIR/CAP_r${R_CUT}.mat"
    echo "Done: $OUTDIR/CAP_r${R_CUT}.mat" | tee -a "$LOG_FILE"
else
    echo "ERROR: CAP_Mat.mat not found in $(pwd)" | tee -a "$LOG_FILE"
    ls -la | tee -a "$LOG_FILE"
    exit 1
fi

echo "Finished: $(date)" | tee -a "$LOG_FILE"
